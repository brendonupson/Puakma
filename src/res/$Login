<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex">
	<title>Tornado Server Login</title>
	<link rel="icon" href="/icons/puakma.ico">
	<style>
	body, td, input {
		font: normal 12px Verdana, Arial, Helvetica, sans-serif;
		letter-spacing: 1px;
	}
	h1 {
		font-size: 1.17em;
		text-align: center;
	}
	hr {
		border: 0;
		border-top: 1px solid #c0c0c0;
	}
	.login {
		margin: 1.5em auto 0 auto;
		border: 2px solid #000000;
		border-collapse: separate;
		background-color: #c0c0c0;
	}
	.login td {
		padding: 4px;
	}
	.login .submit {
		text-align: right;
	}
	.message {
		text-align: center;
		font-weight: bold;
	}
	.logo {
		float: right;
		border: 0;
	}
	</style>
</head>
<body>
<P@Form @P>
<P@Hidden name="$LoginPage" value="1" @P>
<P@Hidden name="$RedirectTo" value="" @P>
<h1>Tornado Server Login</h1>
<hr>
<table class="login" role="presentation">
<tr><td><label for="UserName">UserName:</label></td><td><P@Text name="UserName" value="" size="12" id="UserName" autocomplete="username" autocapitalize="none" spellcheck="false" required="required" autofocus="autofocus" @P></td></tr>
<tr><td><label for="Password">Password:</label></td><td><P@Password name="Password" value="" size="12" id="Password" autocomplete="current-password" required="required" @P></td></tr>
<tr><td></td><td class="submit"><input name="Login" value="Login" type="submit"></td></tr>
</table>
<p class="message" role="alert"><P@Computed name="$MessageString" Value="" @P></p>
</form>
<a href="https://www.puakma.net/" target="_blank" rel="noopener"><img class="logo" src="/icons/tornado.gif" alt="Puakma Tornado Server"></a>
</body>
</html>
